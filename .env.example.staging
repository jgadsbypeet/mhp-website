# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=staging

# Database connection settings
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=false
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=true
# Do not add a trailing slash to the URL
CRAFT_WEB_URL=
CRAFT_WEB_ROOT="/home/someorg/staging/current/web"
SITE_NAME=
SITE_GROUP_NAME="${SITE_NAME}"
PRIMARY_SITE_URL="${CRAFT_WEB_URL}"
CRAFT_RUN_QUEUE_AUTOMATICALLY=true
CRAFT_ADMIN_URL="boiler-admin"
