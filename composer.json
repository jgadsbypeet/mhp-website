{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/ckeditor": "^5.5.0",
    "craftcms/cms": "^5.10.13.2",
    "miranj/craft-obfuscator": "^1.2.0",
    "nystudio107/craft-cookies": "^5.0.0",
    "nystudio107/craft-retour": "^5.0.0",
    "nystudio107/craft-seomatic": "^5.1.22",
    "nystudio107/craft-typogrify": "^5.0.3",
    "nystudio107/craft-vite": "^5.0.2",
    "putyourlightson/craft-dashboard-begone": "^3.0.0",
    "putyourlightson/craft-datastar": "^1.0.2",
    "putyourlightson/craft-sherlock": "^5.2.1",
    "verbb/expanded-singles": "^3.0.0",
    "verbb/formie": "^3.1.34",
    "verbb/image-resizer": "^4.0.0",
    "verbb/knock-knock": "^3.0.6",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
