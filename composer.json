{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "clubstudioltd/craft-asset-rev": "^8.0.0",
    "craftcms/ckeditor": "^4.0.0",
    "craftcms/cms": "^5.0.0",
    "doublesecretagency/craft-cpcss": "^3.0.0",
    "miranj/craft-obfuscator": "^1.2.0",
    "mmikkel/cp-field-inspect": "^2.0.0",
    "nystudio107/craft-cookies": "^5.0.0",
    "nystudio107/craft-seomatic": "^5.0.0-beta.7",
    "nystudio107/craft-typogrify": "^5.0.0",
    "putyourlightson/craft-dashboard-begone": "^3.0.0",
    "verbb/formie": "^3.0.0-beta.15",
    "verbb/image-resizer": "^4.0.0",
    "verbb/knock-knock": "^3.0.0",
    "vlucas/phpdotenv": "^5.4.0",
    "wbrowar/craft-admin-bar": "^5.0.0-beta.1"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  }
}
