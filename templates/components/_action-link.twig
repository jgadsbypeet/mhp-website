<div class="{{ blockClasseses }}">
	<a href="{{ linkUrl }}" target="{{ linkTarget }}" class="group no-path-fill inline-flex">
		<div class="flex-grow-0 flex-shrink-0 flex-[32px] w-[32px] h-[32px] rounded-full bg-brand group-hover:bg-link-hover group-focus-visible:bg-black flex items-center justify-center mr-2xs md:flex-[40px] md:w-[40px] md:h-[40px]">
			{% if linkOption == "asset" %}
				{# if download link #}
				{{ svg("dist/images/icons/download.svg")|attr({ class: "link-invert group-focus-visible:text-highlight" })}}
			{% else %}
				{{ svg("dist/images/icons/chevron.svg")|attr({ class: "link-invert group-focus-visible:text-highlight" })}}
			{% endif %}
		</div>

		<div class="mt-[4px] md:mt-[6px]">
			<h3 class="heading-sm my-0 pb-[4px] md:pb-[6px]">{{ linkText }}</h3>
		</div>
	</a>
	{# if download link #}
	{% if asset %}
		<div class="body-xs ml-[calc(32px+theme('margin.2xs'))] md:ml-[calc(40px+theme('margin.2xs'))]">
			{{ asset.extension|upper }} | {{ asset.size|filesize }}
		</div>
	{% endif %}
</div>
