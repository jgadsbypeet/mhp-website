{# set jump links array #}
{% set jumpLinks = [] %}
{% set sections = entry.body__section.all() ?? null %}
{# add jump link enabled blocks to jump links array #}
{% if sections %}
  {% for block in sections %}
    {% set contentBlocks = block.body__contentBlock.all() ?? null %}

    {% if contentBlocks %}
      {% for block in contentBlocks %}
        {% if block.type == 'body__heading' and block.heading__jumpLink %}
          {% set jumpLinks = jumpLinks|merge([block]) %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if jumpLinks %}
  <div class="container">
    <div class="max-w-sm mx-auto">
      <nav id="page-contents" aria-label="Page contents" class="mb-6 md:mb-6-lg">
        <h2 class="heading-sm text-black text-left mt-0 mb-2 md:mb-2-lg">{{ label ?? "On this page" }}</h2>

        <ol class="list-reset lc--nbm">
          {% for jumpLink in jumpLinks %}
            <li class="pl-0 mb-2xs">
              {% apply spaceless %}
                <a class="relative inline-block pl-[26px] md:pl-[28px]" href="#heading-{{ jumpLink.id }}">
                  {{ svg("dist/images/icons/jump-link-dash.svg")|attr({ class: "text-secondary-light absolute left-0 top-[10px] md:top-[14px]"}) }}

                  {{ jumpLink.heading__jumpLinkText ?? jumpLink.heading__text }}
                </a>
              {% endapply %}
            </li>
          {% endfor %}
        </ol>
      </nav>
    </div>
  </div>
{% endif %}
