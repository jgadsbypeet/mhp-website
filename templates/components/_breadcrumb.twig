{% set breadcrumbClass = breadcrumbClass ?? "" %}
{% set linkClass = linkClass ?? "" %}

{# get url segments and create an array #}
{% set segments = craft.app.request.segments %}
{% set breadcrumb = [] %}

{# loop the segment and create breadcrumb array  #}
{% for segment in segments %}
  {# remove last segment (current page url) #}
  {% if not loop.last %}
    {% set url = "/" ~ segment %}

    {% set breadcrumbEntry = {
      "title": segment,
      "url": url
    } %}

    {% set breadcrumb = breadcrumb|merge([breadcrumbEntry]) %}
  {% endif %}
{% endfor %}

{% macro breadcrumb(url, title, linkClass) %}
	<li class="flex items-center m-0 pl-0 pb-6 before:content-none">
		<a class="{{ linkClass ?? '' }}" href="{{ url }}">{{ title }}</a>

    {{ svg("dist/images/icons/chevron.svg")|attr({class: "breadcrumb__icon ml-[6px] mr-[8px] md:ml-[10px] md:mr-[12px]"}) }}
	</li>
{% endmacro %}

<div class="breadcrumb text-sm pt-6{{ breadcrumbClass ? ' ' ~ breadcrumbClass : '' }}">
  <nav aria-label="Breadcrumb" class="breadcrumb__nav">
    {# Output the breadcrumb #}
    <ol class="flex flex-wrap -mb-3">
      {{ _self.breadcrumb("/", "Home", linkClass) }}

      {% for entry in breadcrumb %}
        {{ _self.breadcrumb(entry.url, entry.title|replace("-", " ")|capitalize, linkClass) }}
      {% endfor %}
    </ol>
  </nav>
</div>