{% extends "matrix/containers/_standard" %}
{% import "_macro" as macro %}
{% set image = block.image__image.one() %}
{% set crop = block.image__imageRatio == "standard" %}
{% set caption = block.image__caption %}

{% block matrixBlock %}
	<div class="content-image my-8 md:my-8-lg">
		{{ macro.image({
			image: image,
			imageClass: "",
			alt: image.alt,
			sizes: [
				{ maxScreen: "479px", width: 448, height: (crop ? 252 : "") },
				{ maxScreen: "767px", width: 688, height: (crop ? 387 : "") },
				{ maxScreen: "", width: 800, height: (crop ? 450 : "") }
			]
		}) }}

		{{ caption ? ('<div class="border-l-2 border-grey body-xs text-grey max-w-md pl-4 mt-2 md:pl-5 md:mt-2-lg">' ~ caption ~ '</div>')|raw : '' }}
	</div>
{% endblock %}