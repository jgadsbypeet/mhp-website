{% extends "error/error" %}
{# Content is managed in the Globals area #}
{# To preview the page when in dev mode, use {{ siteUrl }}/error/404 #}

{% set title = pageNotFound.global__pageTitle ?? 'Page not found' %}
{% set text = pageNotFound.text__text ?? '' %}
{% set breadcrumb = false %}

{% block errorMessage %}
	{% if text|length %}
		{{ text }}
	{% else %}
		<p>We couldn't find that page. Try using the <a href="/search">site search</a> to find what you're looking for or contact us.</p>
	{% endif %}
{% endblock %}