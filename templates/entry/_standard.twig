{% extends "_layout" %}

{% set heroImage = entry.heroImage.one() ?? null %}
{% set bodyJumpLinks = entry.content__content.type("content__heading").heading__jumpLink(":notempty:").all() ?? null %}
{% set bodyContent = entry.content__content.all() ?? null %}

{% block adminBar %}
  {{ adminBar({editLinkUrl: entry.cpEditUrl, editLinkLabel: "entry"}) }}
{% endblock %}

{% block content %}
  {% apply typogrify %}
    {% block hero %}
      {% include "components/hero/_standard" with {
        title: entry.title ?? "",
        standfirst: entry.standfirst ?? ""
      } %}
    {% endblock %}
    
    <div class="site-content py-10 lg:py-10-lg">
      {% block jumplinks %}
        {% include "components/_jump-links" %}
      {% endblock %}

      {% block body %}
        <div class="matrix-sections">
          {% include "_matrix" with { 
            "matrix": bodyContent 
          } %}
          
          {% if cookiePolicyEntry %}
            {% if entry.id == cookiePolicyEntry.id %}
              {% include "components/_cookie-preference-toggle" %}
            {% endif %}
          {% endif %}
        </div>
      {% endblock %}
    </div>
  {% endapply %}
{% endblock %}