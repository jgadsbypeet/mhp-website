{% extends "_entry/standard" %}

{% block hero %}
  {% include "_components/hero/listing" with {
    title: entry.title ?? "",
    standfirst: entry.standfirst ?? ""
  } %}
{% endblock %}

{# TODO: add listing query logics and filtering #}
{% set listChannel = entry.listByChannel %}
{% set entriesPerPage = 10 %}
{% set listByChannel = craft.entries().section(listChannel).with(['url', 'title']) ?? null %}
{% set allEntries = listByChannel.all() ?? null %}
{% set listEntries = listByChannel.eagerly().limit(entriesPerPage) %}

{# Paginate entries #}
{% paginate listEntries as pageInfo, pageEntries %}

{% block body %}
  <div class="container">
    <div class="max-w-xl mx-auto">
      {% if allEntries %}
        <ul class="standard-cards">
          {% for entry in pageEntries %}
            <li>
              {% include "_components/entry-card/standard" with {
                cardStyle: "standard",
                headingTag: "h2",
                cardUrl: entry.url,
                cardTitle: entry.title,
                cardExcerpt: entry.standfirst ?? null,
              } %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>There are no entries yet.</p>
      {% endif %}

      {# Page numbers #}
      {% if pageInfo.totalPages > 1 %}
        {% include "_components/pagination/standard" with {
          type: "mobile",
          blockClasses: "mt-7 md:hidden"
        } %}

        {% include "_components/pagination/standard" with {
          blockClasses: "hidden md:block md:mt-7-lg"
        } %}
      {% endif %}
    </div>
  </div>
{% endblock %}