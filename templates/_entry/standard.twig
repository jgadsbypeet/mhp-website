{% extends "_layout" %}

{% set heroImage = entry.heroImage.one() ?? null %}
{% set bodyContent = entry.content__content.all() ?? null %}
{% set bodyJumpLinks = [] %}
{% if bodyContent %}
  {% for section in bodyContent %}
    {% for block in section.content__section.all() ?? [] %}
      {% if block.type == 'content__heading' and block.heading__jumpLink %}
        {% set bodyJumpLinks = bodyJumpLinks|merge([block]) %}
      {% endif %}
    {% endfor %}
  {% endfor %}
{% endif %}

{% block adminBar %}
  {{ adminBar({editLinkUrl: entry.cpEditUrl, editLinkLabel: "entry"}) }}
{% endblock %}

{% block content %}
  {% apply typogrify %}
    {% block hero %}
      {% include "_components/_hero/standard" with {
        title: entry.title ?? "",
        standfirst: entry.standfirst ?? ""
      } %}
    {% endblock %}

    <div class="site-content">
      {% block jumplinks %}
        {% if bodyJumpLinks %}
          {% include "_components/jump-links" %}
        {% endif %}
      {% endblock %}

      {% block body %}
        <div class="matrix-sections">
          {% apply enkode_emails %}
            {% include "_matrix" with {
              "matrix": bodyContent 
            } %}
          {% endapply %}

          {% if cookiePolicyEntry %}
            {% if entry.id == cookiePolicyEntry.id %}
              {% include "_components/cookie-preference-toggle" %}
            {% endif %}
          {% endif %}
        </div>
      {% endblock %}
    </div>
  {% endapply %}
{% endblock %}