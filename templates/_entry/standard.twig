{% extends '_layouts/base' %}

{% set heroImage = entry.heroImage.one() ?? null %}
{% set bodyContent = entry.content__content.all() ?? null %}
{% set bodyJumpLinks = [] %}
{% if bodyContent %}
  {% for block in bodyContent %}
		{% if (block.type == 'content__heading' and block.heading__jumpLink) or (block.type == 'content__callToAction' and block.heading__jumpLink) %}
			{% set bodyJumpLinks = bodyJumpLinks|merge([block]) %}
		{% endif %}
  {% endfor %}
{% endif %}

{% block content %}
  {% apply typogrify %}
    {% block hero %}
      {% include "_components/_hero/standard" with {
        title: entry.title ?? "",
        standfirst: entry.standfirst ?? ""
      } %}
    {% endblock %}

    <div class="site-content">
      {% block jumplinks %}
        {% if bodyJumpLinks %}
          {% include "_components/jump-links" %}
        {% endif %}
      {% endblock %}

      {% block body %}
        <div class="matrix-sections matrix-section--first section even:bg-secondary">
          {# {% include "_matrix" with {
            "matrix": bodyContent
          } %} #}

          {{ entry.standard__blocks.eagerly().render() }}

          {% if cookiePolicyEntry %}
            {% if entry.id == cookiePolicyEntry.id %}
              {% include "_components/cookie-preference-toggle" %}
            {% endif %}
          {% endif %}
        </div>
      {% endblock %}
    </div>
  {% endapply %}
{% endblock %}