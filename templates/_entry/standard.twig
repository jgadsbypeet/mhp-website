{% extends '_layouts/base' %}

{% set heroImage = entry.heroImage.one() ?? null %}
{% set bodyJumpLinks = entry.standard__blocks
  .type(['block__heading', 'block__callToAction'])
  .heading__jumpLink(true)
  .all() %}

{% block content %}
  {% apply typogrify %}
    {% block hero %}
      {% include "_components/_hero/standard" with {
        title: entry.title ?? "",
        standfirst: entry.standfirst ?? ""
      } %}
    {% endblock %}

    <div class="site-content">
      {% block jumplinks %}
        {% if bodyJumpLinks %}
          {% include "_components/jump-links" %}
        {% endif %}
      {% endblock %}

      {% block body %}
        <div class="matrix-sections matrix-section--first section even:bg-secondary">
          {# standard content blocks #}
          {{ entry.standard__blocks.eagerly().render() }}

          {% if cookiePolicyEntry %}
            {% if entry.id == cookiePolicyEntry.id %}
              {% include "_components/cookie-preference-toggle" %}
            {% endif %}
          {% endif %}
        </div>
      {% endblock %}
    </div>
  {% endapply %}
{% endblock %}