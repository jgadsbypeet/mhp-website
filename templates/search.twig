{% extends '_layouts/base' %}
{# Preview this page at {{ siteName }}/search #}

{% block head %}
	<title>{{ siteName }} | Search Results</title>
{% endblock %}

{% set searchQuery = craft.app.request.getParam("q") %}
{% set entriesPerPage = 10 %}
{% set totalResults = searchQuery ? craft.entries().section("not webDoc").searchResults(true).search(searchQuery).with(['url', 'title']) : null %}
{% set searchResults = searchQuery ? totalResults.limit(entriesPerPage) : null %}

{% block content %}
	{% include "_components/hero/simple" with {
    title: 'Search results',
  } %}

	<div class="site-content section" data-signals="{offset: 0}">
		<div class="container">
			{% include "_components/site-search/form" with {
        classes: "w-full",
        liveSearch: true,
      } %}

      {# when live search (by datastar) is used, this part will be loaded from site-search/live-results.twig #}
      <div id="search-results">
        {% if searchQuery %}
          <h2>{{ totalResults|length }} result{{ totalResults|length == 1 ? '' : 's'}}{{ totalResults|length ? ':' : ''}}</h2>
        {% endif %}

        {% if searchResults|length %}
          {% paginate searchResults as pageInfo, searchResults %}

          {% for entry in searchResults %}
            {% include "_components/entry-card/simple" with {
              cardUrl: entry.url,
              cardTitle: entry.title,
            } %}
          {% endfor %}

          {% if pageInfo.totalPages > 1 %}
            {% include "_components/pagination/standard" %}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}