{% set breadcrumb = breadcrumb ?? null %}
<div class="pt-4 pb-8 bg-secondary md:pt-4-lg md:pb-8-lg">
  <div class="container">
    {% if breadcrumb %}
      {% include "_components/breadcrumb/standard" %}
    {% else %}
      {% include "_components/breadcrumb/home" %}
    {% endif %}

    {% if title %}
      <h1 class="heading-xxl">{{ title }}</h1>
    {% endif %}
  </div>
</div>