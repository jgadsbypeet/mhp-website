{% set linkOption = linkOption ?? '' %}
{% set linkUrl = linkUrl ?? '' %}
{% set linkText = linkText ?? '' %}
{% set linkTarget = linkTarget ?? '' %}
{% set linkSource = linkSource ?? '' %}

{% if linkOption == "assetLink" %}
  {% set asset = link is defined and link ? link.element : null %}
  {% set format = asset ? asset.extension|upper : '' %}
  {% set lengthLabel = length ?? '' %}
  {% set summary = summary ?? '' %}
  {% set cover = cover ?? '/dist/assets/images/document-download-fallback.png' %}
  {% set filesize = '' %}
  {% if asset and asset.size is not null %}
    {% set bytes = asset.size %}
    {% set mb = bytes / 1048576 %}
    {% if mb >= 1 %}
      {% set filesize = mb|number_format(1) ~ " MB" %}
    {% else %}
      {% set filesize = (bytes / 1024)|round ~ " KB" %}
    {% endif %}
  {% endif %}

  <div class="document-downloads">
    <article class="document-download">
      <img class="document-download__cover" src="{{ cover }}" alt="" width="70" height="100">
      <div class="document-download__content">
        {% if linkUrl %}
          <a class="document-download__title" href="{{ linkUrl }}"{% if linkTarget %} target="{{ linkTarget }}"{% if linkTarget == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}>{{ linkText }}</a>
        {% else %}
          <p class="document-download__title">{{ linkText }}</p>
        {% endif %}
        {% if format or filesize or lengthLabel %}
          <p class="document-download__meta">
            {% if format %}<span>{{ format }}</span>{% endif %}
            {% if filesize %}<span>{{ filesize }}</span>{% endif %}
            {% if lengthLabel %}<span>{{ lengthLabel }}</span>{% endif %}
          </p>
        {% endif %}
        {% if summary %}
          <p class="document-download__summary">{{ summary }}</p>
        {% endif %}
      </div>
    </article>
  </div>
{% else %}
  <div class="action-links">
    <a class="action-link" href="{{ linkUrl }}"{% if linkTarget %} target="{{ linkTarget }}"{% if linkTarget == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}>
      <span class="action-link__icon">
        <img src="/dist/assets/images/icons/{{ linkOption == 'urlLink' ? 'action-arrow-external.svg' : 'action-arrow-right.svg' }}" alt="" width="32" height="32">
      </span>
      <span class="action-link__body">
        <span class="action-link__label">{{ linkText }}{% if linkOption == 'urlLink' %}<span class="sr-only"> (external)</span>{% endif %}</span>
        {% if linkSource %}
          <span class="action-link__source">{{ linkSource }}</span>
        {% endif %}
      </span>
    </a>
  </div>
{% endif %}
