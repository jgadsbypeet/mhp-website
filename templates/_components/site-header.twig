<header class="site-header w-full relative z-10">
  <div class="header-nav--overlay fixed top-0 left-0 right-0 h-screen bg-[rgba(0,0,0,.5)] hidden [&.active]:block"></div>

  <div class="site-header--top relative py-4 md:py-4-lg bg-white">
    <div class="container">
      <div class="flex justify-between items-center max-w-xl mx-auto">
        <div class="site-logo">
          <a class="main-logo block" href="/" aria-label="Return home">
            {{ svg("dist/assets/images/logos/site-logo-colour.svg")|attr({ class: "w-auto h-[48px] md:h-[72px]" }) }}

            <span class="sr-only">{{ siteName }}</span>
          </a>
        </div>

        <div class="hidden justify-end nav:flex">
          {% include "_components/search-form" %}
        </div>

        <button id="mobileNavButton" class="custom-button group p-0 text-interactions inline-flex nav:hidden" value="Menu" aria-haspopup="true" aria-expanded="false" aria-controls="Main navigation">
          <span class="burger-menu-button-text body-xs text-red-dark font-normal mr-[4px]">Menu</span>

          {{ svg("dist/assets/images/icons/burger-menu.svg")|attr({ class: "block group-[.active]:hidden"}) }}
          {{ svg("dist/assets/images/icons/burger-menu-close.svg")|attr({ class: "hidden group-[.active]:block"}) }}
        </button>
      </div>
    </div>
  </div>

  {# navigation#}
  {% include "_components/site-header-nav" %}
</header>