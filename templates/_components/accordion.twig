{% set class = class ?? "" %}
{% set bodyType = bodyType ?? "" %}

<details class="accordion{{ class ? ' ' ~ class : '' }}"{% if open ?? false %} open{% endif %}>
  <summary class="accordion__summary">
    <span>{{ heading }}</span>
    <img class="accordion__icon" src="/dist/assets/images/icons/accordion-chevron.svg" alt="" width="28" height="28">
  </summary>
  <div class="accordion__panel">
    {% if bodyType == "matrix" %}
      {{ body.eagerly().render() }}
    {% else %}
      {{ body }}
    {% endif %}
  </div>
</details>
