{% set classes = classes ?? "" %}

<form role="search" placeholder="Search our site" class="search-form flex bg-white-off{{ classes ? " " ~ classes : "" }}" action="{{ url('search') }}">
  <input type="search" class="!mb-0 md:!mb-0 grow w-full border-none bg-transparent" name="q" aria-label="search text" placeholder="Search" value="{{ searchQuery ?? '' }}" />
  
  <button type="submit" class="flex-none !px-[14px] rounded-none" value="Search">
    {{ svg("dist/assets/images/icons/magnifying-glass.svg")|attr({ class: ""}) }}

    <span class="visually-hidden">Search</span>
  </button>
</form>