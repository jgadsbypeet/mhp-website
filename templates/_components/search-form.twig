{% set classes = classes ?? "" %}

<form role="search" class="search-form flex{{ classes ? " " ~ classes : "" }}" action="{{ url('search') }}" aria-label="Site search">
  <input type="search" class="!mb-0 md:!mb-0 grow w-full" name="q" placeholder="Search the site" value="{{ searchQuery ?? '' }}" />

  <button type="submit" value="Search" class="p-2 rounded-none">
    {{ svg("dist/assets/images/icons/magnifying-glass.svg")|attr({ class: "w-auto h-[2.4rem]"}) }}
    <span class="sr-only">Search the site</span>
  </button>
</form>