{% macro menuItem(url, title) %}
	<li class="" role="none">
		<a role="menuitem" class="inline-block" tabindex="-1" href="{{ url }}">{{ title }}</a>
	</li>
{% endmacro %}

<div id="siteHeaderNav" class="site-header--nav hidden [&.active]:block bg-grey nav:block">
	<nav id="mainNav" class="header-nav bg-grey lc--nbm absolute left-0 right-0 z-10 nav:relative" aria-label="Main navigation">
		{# nav sections - menu bar #}
		<ul class="header-nav__menu-bar px-sm md:px-lg nav:flex nav:items-center nav:max-w-xl nav:mx-auto" role="menubar" aria-label="Main navigation">
			{% nav menu in menus %}
        <li class="border-t border-black py-sm first:border-none nav:border-none" role="none">
          {% if menu.subLinks|length %}
            <span class="header-nav__panel--trigger group link link-no-underline font-semibold flex items-center justify-between cursor-pointer nav:mr-lg" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="0">
              {{- menu.title -}}
              {{ svg("dist/assets/images/icons/chevron-down.svg")|attr({ class: "mt-[3px] -mr-[3px] w-auto h-[20px] block group-[.active]:hidden md:h-[24px] nav:ml-[3px]" }) }}
              {{ svg("dist/assets/images/icons/chevron-up.svg")|attr({ class: "mt-[3px] -mr-[3px] w-auto h-[20px] hidden group-[.active]:block md:h-[24px] nav:ml-[3px]" }) }}
            </span>
          {% else %}
            <a class="inline-block font-semibold link-no-underline nav:mr-lg" tabindex="0" href="{{ menu.url }}">
              {{ menu.title }}
            </a>
          {% endif %}

          {# show/hide nav panels - first level menu #}
          <ul class="header-nav__panel hidden [&.active]:block bg-grey border-t border-t-black mt-sm pt-sm pb-2xs nav:absolute nav:top-full nav:mt-0 nav:-ml-3xl nav:px-3xl nav:pb-2xl nav:border-none" role="menu" aria-label="{{ menu.title }}">
            <li class="" role="none">
              <div class="header-nav__main" role="none">
                <a role="menuitem" class="inline-block font-semibold mb-xs" tabindex="-1" href="{{ menu.url }}">{{ menu.title }}</a>
              </div>

              {# get descendants #}
              {% set menuAsEntry = craft.entries()
                  .section(menu.section)
                  .slug(menu.url|replace("/", ""))
                  .one() ?? null %}

              {% if menuAsEntry %}
                {% set subPages = craft.entries()
                    .descendantOf(menuAsEntry)
                    .descendantDist(1)
                    .all() ?? null %}
                {# second level menus #}
                {% if subPages %}
                  <ul class="header-nav__sub" role="menu" aria-label="{{ menu.title }}">
                    {% for menu in subPages %}
                      {{ _self.menuItem(menu.url, menu.title) }}
                    {% endfor %}
                  </ul>
                {% endif %}
              {% elseif menu.subLinks %}
                {# second level menus #}
                <ul class="header-nav__sub" role="menu" aria-label="{{ menu.title }}">
                  {% for menu in menu.subLinks %}
                    {{ _self.menuItem(menu.url, menu.title) }}
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          </ul>
        </li>
			{% endnav %}
		</ul>
	</nav>
</div>