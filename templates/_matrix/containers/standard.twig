{% set matrixClass = matrixClass ?? "" %}

<div class="matrix matrix--{{ block.type|kebab }}{{ matrixClass ? ' ' ~ matrixClass : '' }}">
  <div class="container">
    <div class="max-w-md">
      {% block matrixBlock %}
        <p>Matrix "{{ block.type|kebab|replace("content-", "") }}" not found</p>
      {% endblock %}
    </div>
  </div>
</div>