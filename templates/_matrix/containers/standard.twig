{% set matrixClasses = matrixClasses ?? "" %}

<div class="matrix matrix--{{ block.type|kebab }}{{ matrixClasses ? ' ' ~ matrixClasses : '' }}">
  <div class="container">
    <div class="max-w-md">
      {% block matrixBlock %}
        <p>Matrix "{{ block.type|kebab|replace("content-", "") }}" not found</p>
      {% endblock %}
    </div>
  </div>
</div>