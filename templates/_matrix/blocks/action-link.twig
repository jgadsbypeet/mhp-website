{% extends "_matrix/containers/standard" %}
{% set type = block.action__option ?? "entryLink" %}
{% set link = block.action__entryLink ?? null %}
{% if type == "assetLink" %}
  {% set link = block.action__assetLink ?? null %}
  {% set linkSource = "" %}
{% elseif type == "urlLink" %}
  {% set link = block.action__urlLink ?? null %}
{% endif %}

{% block matrixBlock %}
  {% include "_components/action-link" with {
    blockClasseses: "my-8 md:my-8-lg",
    linkOption: type,
    linkUrl: link.value,
    linkTarget: link.target,
    linkText: link.label,
  } %}
{% endblock %}