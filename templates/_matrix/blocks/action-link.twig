{% extends "_matrix/containers/standard" %}

{% set linkUrl = "" %}
{% set linkTarget = "" %}
{% set asset = "" %}
{% set linkText = block.action__linkText ?? "More info" %}
{% if block.action__option == "assetLink" %}
  {% set asset = block.action__assetLink.one() %}
  {% set linkUrl = asset.url %}
{% elseif block.action__option == "urlLink" %}
  {% set linkTarget = block.action__linkTarget %}
  {% set linkUrl = block.action__urlLink %}
{% elseif block.action__option == "entryLink" %}
  {% set linkUrl = block.action__entryLink.one().url %}
{% endif %}

{% block matrixBlock %}
  {% include "_components/action-link" with {
    blockClasseses: "my-8 md:my-8-lg",
    linkOption: block.action__option, 
    linkUrl: linkUrl,
    linkTarget: linkTarget,
    linkText: linkText,
  } %}
{% endblock %}