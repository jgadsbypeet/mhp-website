{% extends "_matrix/containers/w-xl" %}
{% set logos = block.logos__logos.all() ?? '' %}

{% block matrixBlock %}
	{% if logos %}
		<div class="flex flex-row flex-wrap my-5 container-spacing-gap md:my-5-lg fm--ntm lm--nbm">
			{% for logo in logos %}
				{# An algorithm is used to proportionally size logos based on their aspect ratio. This way square logos should hopefully ‘feel’ the same sizes as landscape ones. #}
				{% set aspectRatio = logo.width / logo.height %}
				{% if aspectRatio < 1.5 %}
					{% set logoWidth = "[50%]" %}
				{% elseif aspectRatio >= 1.5 and aspectRatio < 2.5 %}
					{% set logoWidth = "[70%]" %}
				{% elseif aspectRatio >= 2.5 and aspectRatio < 5 %}
					{% set logoWidth = "[85%]" %}
				{% elseif aspectRatio >= 5 %}
					{% set logoWidth = "full" %}
				{% endif %}
				<div class="flex-grow-0 flex-shrink-0 max-w-full w-[200px] md:w-[240px]{{ loop.length > 1 ? ' sm:flex items-center justify-center' }}">
					<img src="{{ logo.url }}" class="block w-{{ logoWidth }} h-auto" width="{{ logo.width }}" height="{{ logo.height }}" alt="{{ logo.title }}" />
				</div>
			{% endfor %}
		{% endif %}
	</div>
{% endblock %}