{% extends "_matrix/containers/standard" %}
{% import "_macro" as macro %}
{% set image = block.image__image.one() %}
{% set crop = block.image__imageRatio == "standard" %}
{% set caption = block.image__caption ?? "" %}
{% set attribution = image.image__attribution ?? "" %}

{% block matrixBlock %}
	<div class="my-8 content-image md:my-8-lg">
		{{ macro.image({
			image: image,
			imageClass: "",
			alt: image.alt,
			sizes: [
				{ maxScreen: "479px", width: 448, height: (crop ? 252 : "") },
				{ maxScreen: "767px", width: 688, height: (crop ? 387 : "") },
				{ maxScreen: "", width: 800, height: (crop ? 450 : "") }
			]
		}) }}

		{% if caption or attribution %}
			<p class="mt-2 mb-0 reading-width body-xs text-secondary-text md:mt-2-lg">
				{{ caption|raw }}
				{{ attribution ? ' Image: ' ~ attribution : '' }}
			</p>
		{% endif %}
	</div>
{% endblock %}