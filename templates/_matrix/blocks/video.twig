{% extends "_matrix/containers/standard" %}
{% import "_macro" as macro %}

{% set videoOption = block.video__option %}
{% set video = "" %}
{% set videoUrl = "" %}
{% set transcript = block.video__transcript %}
{% if videoOption == "videoUpload" %}
	{% set video = block.video__videoFile.one() %}
{% else %}
	{% set videoUrl = block.video__videoUrl.value %}
{% endif %}
{% set coverImage = block.video__coverImage.one() ?? null %}

{% block matrixBlock %}
  <div class="relative my-8 video md:my-8-lg">
    <div class="video__frame relative pt-[56.25%] bg-black overflow-hidden{% if coverImage %} cover-image{% endif %}">
      {% if video %}
        <video class="absolute top-0 bottom-0 left-0 right-0 video__asset video__asset--uploaded" controls>
          <source src="{{ url(video.url(), { v: video.dateModified.timestamp }) }}">
          Your browser does not support the video tag.
        </video>
      {% else %}
        {{ macro.videoEmbed(videoUrl) }}
      {% endif %}

      {% if coverImage %}
        <button class="absolute top-0 left-0 h-full video__button button-reset group text-reversed-text hover:text-primary-text">
          {{ macro.image({
            image: coverImage,
            imageClass: "",
						alt: coverImage.alt,
            sizes: [
              { maxScreen: "479px", width: 448, height: 252 },
              { maxScreen: "767px", width: 688, height: 387 },
              { maxScreen: "", width: 800, height: 450 }
            ]
          }) }}

          <span class="visually-hidden">Play video</span>
          <div class="absolute bottom-0 left-0 w-[80px] h-[80px] bg-secondary flex flex-col items-center justify-center group-hover:text-reversed-text group-hover:bg-black group-focus-visible:bg-focus-light md:bottom-auto md:left-1/2 md:top-1/2 md:-translate-x-1/2 md:-translate-y-1/2">
            {{ svg('dist/assets/images/icons/play.svg')|attr({class: 'video__play-icon block w-[19px] ml-[3px]'}) }}
          </div>
        </button>
      {% endif %}
    </div>

    {% if transcript %}
      {% include "_components/accordion" with {
        class: "video",
        index: "",
        heading: "Read video transcript",
        body: transcript,
				blockId: block.id
      } %}
    {% endif %}
  </div>
{% endblock %}