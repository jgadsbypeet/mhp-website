{% extends "_matrix/containers/standard" %}

{% set el = block.heading__size %}

{% if block.heading__jumpLink %}
  {% set headingId = "heading-" ~ block.id %}
{% else %}
  {% set headingId = "" %} 
{% endif %}

{% block matrixBlock %}
  <{{ el }} {{ headingId ? "id=" ~ headingId : "" }}>{{ block.heading__heading }}</{{ el }}>
{% endblock %}