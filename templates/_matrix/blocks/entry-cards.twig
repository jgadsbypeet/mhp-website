{% extends "_matrix/containers/w-xl" %}

{% set entries = block.entryCards__entries.all() ?? null %}
{% set threeCol = block.entryCards__columns %}

{% block matrixBlock %}
  <div class="my-8 md:my-8-lg">
    {% if entries %}
      <ul class="list-reset -mt-6 -ml-6 mb-0 md:-mt-6-lg md:-ml-6-lg md:flex">
        {% for entry in entries %}
          {% set heroImage = entry.heroImage.one() ?? null %}

          <li class="mt-6 ml-6 mb-0 md:mt-6-lg md:ml-6-lg md:basis-1/2{% if threeCol %} lg:basis-1/3{% endif %}">
            {% include "_components/_entry-card/standard" with {
              cardHeroImage: heroImage,
              cardUrl: entry.url,
              cardTitle: entry.title,
              cardExcerpt: entry.standfirst,
            } %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endblock %}