{% extends "_partials/block-containers/standard" %}

{% set cite = entry.quote__cite ?? '' %}

{% block matrixBlock %}
	<blockquote class="flex my-5 md:my-5-lg fm--ntm lm--nbm">
		<div class="block w-[4px] bg-primary rounded flex-grow-0 flex-shrink-0"></div>
		<div class="px-4 py-3 md:py-3-lg md:px-4-lg">
			<p class="mb-1 md:mb-1-lg">{{ entry.quote__text }}</p>
			{% if cite %}
				<p class="mb-0 body-xs text-secondary-text">{{ cite }}</p>
			{% endif %}
		</div>
	</blockquote>
{% endblock %}