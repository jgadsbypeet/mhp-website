{% extends "_partials/block-containers/standard" %}

{% set cite = entry.quote__cite ?? '' %}

{% block matrixBlock %}
  <blockquote class="blockquote">
    <p>“{{ entry.quote__text }}”</p>
    {% if cite %}
      <p class="blockquote__cite">{{ cite }}</p>
    {% endif %}
  </blockquote>
{% endblock %}
