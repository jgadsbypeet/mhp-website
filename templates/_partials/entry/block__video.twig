{% extends "_partials/block-containers/standard" %}
{% import "_macro" as macro %}

{% set videoOption = entry.video__option %}
{% set video = "" %}
{% set videoUrl = "" %}
{% set transcript = entry.video__transcript %}
{% if videoOption == "videoUpload" %}
  {% set video = entry.video__videoFile.one() %}
{% else %}
  {% set videoUrl = entry.video__videoUrl.value %}
{% endif %}
{% set coverImage = entry.video__coverImage.one() ?? null %}

{% block matrixBlock %}
  <div class="video-block">
    <div class="video__frame{% if coverImage %} cover-image{% endif %}">
      {% if video %}
        <video class="video__asset video__asset--uploaded" controls>
          <source src="{{ url(video.url(), { v: video.dateModified.timestamp }) }}">
          Your browser does not support the video tag.
        </video>
      {% else %}
        {{ macro.videoEmbed(videoUrl) }}
      {% endif %}

      {% if coverImage %}
        <button type="button" class="video__button custom-button">
          {{ macro.image({
            image: coverImage,
            imageClass: "",
            alt: coverImage.alt,
            sizes: [
              { maxScreen: "640px", width: 592, height: 333 },
              { maxScreen: "", width: 904, height: 509 }
            ]
          }) }}
          <img class="video__play" src="/dist/assets/images/icons/video-play.svg" alt="" width="80" height="80">
          <span class="sr-only">Play video</span>
        </button>
      {% endif %}
    </div>

    {% if transcript %}
      {% include "_components/accordion" with {
        heading: "Transcript",
        body: transcript,
      } %}
    {% endif %}
  </div>
{% endblock %}