{% extends "_partials/block-containers/w-xl" %}
{% import "_macro" as macro %}

{# action link #}
{% set button = entry.cta__actionLink.one() %}
{% set linkText = button.action__linkText ?? "More info" %}
{% set type = button.action__option ?? "entryLink" %}
{% set link = button.action__entryLink ?? null %}
{% if type == "assetLink" %}
  {% set link = button.action__assetLink ?? null %}
  {% set linkSource = "" %}
{% elseif type == "urlLink" %}
  {% set link = button.action__urlLink ?? null %}
{% endif %}

{% set image = entry.cta__image.one() ?? null %}

{% block matrixBlock %}
  <div class="my-8 md:my-8-lg md:flex md:flex-row-reverse bg-secondary group hover:cursor-pointer data-link" data-link="{{ link.value }}">
    {% if image %}
      <div class="overflow-hidden md:basis-1/2">
        {{ macro.image({
          image: image,
          imageClass: "w-full h-full object-cover",
          alt: image.alt,
          sizes: [
            { maxScreen: "479px", width: 447, height: 251 },
            { maxScreen: "575px", width: 527, height: 296 },
            { maxScreen: "767px", width: 719, height: 404 },
            { maxScreen: "", width: 592, height: 333 }
          ]
        }) }}
      </div>
    {% endif %}

    <div class="p-sm md:p-lg{% if image %} md:basis-1/2{% endif %}">
      <h2 id="heading-{{ entry.id }}" class="mt-0 text-inherit">{{ entry.cta__heading }}</h2>

      <p>{{ entry.cta__text }}</p>

      {% include "_components/action-link" with {
        blockClasseses: "my-8 md:my-8-lg",
        linkOption: type,
        linkUrl: link.value,
        linkTarget: link.target,
        linkText: link.label,
      } %}
    </div>
  </div>
{% endblock %}