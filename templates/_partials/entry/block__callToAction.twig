{% extends "_partials/block-containers/fullwidth" %}

{% set button = entry.cta__actionLink.one() ?? null %}
{% set image = entry.cta__image.one() ?? null %}
{% set heading = entry.cta__heading ?? "" %}
{% set text = entry.cta__text ?? "" %}
{% set linkUrl = "" %}
{% set linkTarget = "" %}
{% set linkText = "" %}

{% if button %}
  {% set type = button.action__option ?? "entryLink" %}
  {% set link = button.action__entryLink ?? null %}
  {% if type == "assetLink" %}
    {% set link = button.action__assetLink ?? null %}
  {% elseif type == "urlLink" %}
    {% set link = button.action__urlLink ?? null %}
  {% endif %}
  {% set linkUrl = link.value ?? "" %}
  {% set linkTarget = link.target ?? "" %}
  {% set linkText = button.action__linkText ?? link.label ?? "" %}
{% endif %}

{% block matrixBlock %}
  <div class="cta-banner{% if image %} cta-banner--photo{% endif %}">
    <div class="cta-banner__media">
      {% if image %}
        <img src="{{ image.url }}" alt="" width="{{ image.width }}" height="{{ image.height }}">
      {% else %}
        <img src="/dist/assets/images/cta-flare.png" alt="" width="1067" height="1067">
      {% endif %}
    </div>
    {% if not image %}
      <div class="cta-banner__noise" style="--cta-noise: url('/dist/assets/images/cta-noise.png')"></div>
    {% endif %}

    <div class="container">
      <div class="cta-banner__content">
        {% if heading %}
          <h2 id="heading-{{ entry.id }}" class="cta-banner__heading">
            {% for word in heading|split(' ') %}
              {% if word %}<span>{{ word }}</span>{% endif %}
            {% endfor %}
          </h2>
        {% endif %}

        {% if text %}
          <p class="cta-banner__text">{{ text|nl2br }}</p>
        {% endif %}

        {% if linkUrl and linkText %}
          <a class="cta-banner__action" href="{{ linkUrl }}"{% if linkTarget %} target="{{ linkTarget }}"{% if linkTarget == '_blank' %} rel="noopener noreferrer"{% endif %}>
            {{- linkText -}}
            {% if linkTarget == '_blank' %}<span class="sr-only"> (external)</span>{% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
