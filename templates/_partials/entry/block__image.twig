{% extends "_partials/block-containers/standard" %}
{% import "_macro" as macro %}
{% set image = entry.image__image.one() %}
{% set standard = entry.image__imageRatio == "standard" %}
{% set caption = entry.image__caption ?? "" %}
{% set attribution = image.image__attribution ?? "" %}

{% block matrixBlock %}
  <figure class="body-image{{ standard ? ' body-image--standard' : ' body-image--fit' }}">
    {{ macro.image({
      image: image,
      imageClass: "body-image__media",
      alt: image.alt,
      sizes: [
        { maxScreen: "640px", width: 592, height: (standard ? 333 : "") },
        { maxScreen: "", width: 904, height: (standard ? 509 : "") }
      ]
    }) }}

    {% if caption or attribution %}
      <figcaption class="body-image__caption">
        <img class="body-image__camera" src="/dist/assets/images/icons/image-caption-camera.svg" alt="" width="16" height="16">
        {{ caption }}{% if attribution %} Image: {{ attribution }}{% endif %}
      </figcaption>
    {% endif %}
  </figure>
{% endblock %}
