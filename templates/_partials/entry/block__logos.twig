{% extends "_partials/block-containers/w-xl" %}
{% import "_macro" as macro %}
{% set logos = entry.logos__logos.eagerly().all() ?? [] %}

{% block matrixBlock %}
  {% if logos %}
    <div class="partner-logos">
      <ul class="partner-logos__grid">
        {% for logo in logos %}
          <li>
            {{ macro.image({
              image: logo,
              imageClass: "",
              alt: logo.title,
              sizes: [
                { maxScreen: "640px", width: 280, height: "" },
                { maxScreen: "", width: 480, height: "" }
              ]
            }) }}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endblock %}
