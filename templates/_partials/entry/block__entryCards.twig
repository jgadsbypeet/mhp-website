{% extends "_partials/block-containers/w-xl" %}

{% set entries = entry.entryCards__entries.eagerly().all() ?? null %}
{% set threeCol = entry.entryCards__columns %}

{% block matrixBlock %}
  <div class="my-8 md:my-8-lg">
    {% if entries %}
      <ul class="flex flex-col gap-6 md:flex-row md:gap-6-lg">
        {% for entry in entries %}
          {# reset variables after each iteration so we do not get duplicate cards #}
          {% set cardHeroImage = "" %}
          {% set cardUrl = "" %}
          {% set cardTitle = "" %}
          {% set cardExcerpt = "" %}

          {# get card details #}
          {% set heroImage = entry.heroImage.one() ?? null %}

          <li class="md:basis-1/2{% if threeCol %} lg:basis-1/3{% endif %}">
            {% include "_components/entry-card/standard" with {
              cardHeroImage: heroImage,
              cardUrl: entry.url,
              cardTitle: entry.title,
              cardExcerpt: entry.standfirst,
            } %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endblock %}