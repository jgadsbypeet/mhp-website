{% extends "_partials/block-containers/w-xl" %}
{% set matrixClasses = "related-content" %}

{% set entries = entry.entryCards__entries.eagerly().all() ?? null %}
{% set threeCol = entry.entryCards__columns %}

{% block matrixBlock %}
  {% if entries %}
    <ul class="related-content__list{% if threeCol %} related-content__list--three{% endif %}">
      {% for entry in entries %}
        {% set heroImage = entry.heroImage.one() ?? null %}

        <li>
          {% include "_components/entry-card/standard" with {
            cardHeroImage: heroImage,
            cardUrl: entry.url,
            cardTitle: entry.title,
            cardExcerpt: entry.standfirst ?? null,
          } %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endblock %}
