{% extends "_partials/block-containers/standard" %}
{% set accordions = entry.acc__accordion.all() %}

{% block matrixBlock %}
  {% for item in accordions %}
    {% set blockClasses = "my-4 md:my-4-lg first:mt-8 md:first:mt-8-lg last:mb-8 md:last:mb-8-lg" %}

    {% include "_components/accordion" with {
      heading: item.acc__heading,
      body: item.acc__content.all(),
      bodyType: "matrix",
			blockId: item.id
    } %}
  {% endfor %}
{% endblock %}